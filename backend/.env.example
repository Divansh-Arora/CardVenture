# Postgres connection string (Railway Postgres, Neon, Render Postgres, Supabase, etc.)
# Format: postgresql://user:password@host/dbname
# Railway provides this automatically when you add a PostgreSQL service
DATABASE_URL=

# NVIDIA build.nvidia.com API key (get yours at https://build.nvidia.com)
# Never commit the real value
NVIDIA_API_KEY=

# NVIDIA API base URL (OpenAI-compatible endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model to use for card generation
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Comma-separated list of frontend origins allowed to call this API
# Include your local dev URL and your deployed frontend URL(s)
CORS_ORIGINS=http://localhost:5173

# JWT auth settings
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=5c7d6ea397015f4e27ee268cddd6ab5e1657ae2da97179afd70eadba1ab38866
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080